# Copiez ce fichier en .env et ajustez les valeurs.

# Obligatoire en production : secret de signature des JWT.
# Sans cette variable, un secret de developpement non securise est utilise.
JWT_SECRET=change-me-in-production

# Optionnel : chemin du fichier SQLite (par defaut server/data/yehoo.db).
# YEHOO_DB=server/data/yehoo.db

# Optionnel : port du serveur Express (par defaut 4000).
# PORT=4000

# Optionnel : liste blanche d'origines autorisees pour le CORS, separees par des virgules.
# Laisser vide autorise toutes les origines (pratique en dev).
# CORS_ORIGIN=https://yehoo.example.com

# Moderateurs : numeros (format +224XXXXXXXXX) autorises a traiter les signalements
# via /api/admin/reports. Separes par des virgules.
# ADMIN_PHONES=+224620000003
